# Database URL para Supabase PostgreSQL (Connection Pooling)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgboiler=true"

# Direct Connection URL para Supabase PostgreSQL (para Prisma Migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="seu-segredo-super-seguro-aqui"

# Google Books API (Opcional - a API pública do Google Books funciona sem chave para requisições básicas)
GOOGLE_BOOKS_API_KEY=""
